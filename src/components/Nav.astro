---
import { AUTHOR_NAME } from "../consts";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const normalizedPath = currentPath.replace(/\/$/, "") || "/";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: "Photos", href: "/photos" },
  {
    label: "Anagrams",
    href: "https://anagrams.brandondionisio.com",
    external: true,
  },
];

function isActive(href: string) {
  const normalizedHref = href.replace(/\/$/, "") || "/";
  return (
    normalizedPath === normalizedHref ||
    normalizedPath.startsWith(normalizedHref + "/")
  );
}
---

<nav
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 lg:right-auto lg:w-auto w-full px-4 py-2 lg:p-6 flex flex-col lg:items-start items-stretch lg:justify-start bg-white/95 dark:bg-zinc-900/95 lg:bg-transparent dark:lg:bg-transparent border-b border-gray-300 dark:border-zinc-600 lg:border-b-0"
  aria-label="Main navigation"
>
  <div
    class="flex flex-row items-center justify-between w-full lg:block lg:w-auto"
  >
    <div
      class="block text-xl font-bold text-primary lg:mb-2 no-underline transition-opacity duration-200"
    >
      {AUTHOR_NAME}
    </div>
    <button
      type="button"
      id="nav-menu-toggle"
      class="lg:hidden flex items-center justify-center rounded-md -mr-2 text-secondary hover:opacity-70 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-900"
      aria-expanded="false"
      aria-controls="nav-mobile-panel"
      aria-label="Open menu"
    >
      <span class="sr-only">Menu</span>
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          id="nav-icon-open"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
        <path
          id="nav-icon-close"
          class="hidden"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <div
    id="nav-mobile-panel"
    class="hidden lg:block w-full lg:w-auto max-lg:absolute max-lg:top-full max-lg:left-0 max-lg:right-0 max-lg:mt-0 max-lg:border-b max-lg:border-gray-300 max-lg:dark:border-zinc-600 max-lg:bg-white/95 max-lg:dark:bg-zinc-900/95 max-lg:shadow-lg max-lg:px-4 max-lg:pb-2"
  >
    <ul
      class="flex flex-col lg:flex-col gap-2 lg:gap-0 list-none m-0 p-0 [&_a]:leading-snug [&_span]:leading-snug max-lg:gap-1"
    >
      {
        navLinks.map((link, index) => {
          const active = !link.external && isActive(link.href);
          const startsExternalGroup =
            link.external && !navLinks[index - 1]?.external;
          return (
            <li
              class:list={[
                startsExternalGroup
                  ? "lg:mt-2 max-lg:pt-2 max-lg:border-t max-lg:border-gray-200 max-lg:dark:border-zinc-700"
                  : undefined,
              ]}
            >
              {active ? (
                <span
                  class="block font-normal text-lg text-secondary underline cursor-default leading-tight"
                  aria-current="page"
                >
                  {link.label}
                </span>
              ) : (
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class:list={[
                    "block text-lg font-normal leading-tight",
                    link.external
                      ? "nav-link--external group transition-colors duration-200"
                      : "transition-opacity duration-200 hover:opacity-70",
                  ]}
                >
                  {link.external ? (
                    <span class="inline-flex items-center gap-1.5">
                      <span
                        class="font-mono transition-transform duration-200 ease-out group-hover:translate-x-0.5"
                        aria-hidden="true"
                      >
                        →
                      </span>
                      {link.label}
                    </span>
                  ) : (
                    link.label
                  )}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  #site-nav a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  #site-nav a:hover {
    color: var(--text-secondary);
  }

  #site-nav a.nav-link--external {
    color: color-mix(in srgb, var(--text-secondary) 75%, transparent);
  }

  #site-nav a.nav-link--external:hover {
    color: var(--text-secondary);
  }
</style>

<script>
  // @ts-nocheck
  let mobileNavAbort = null;

  function initMobileNav() {
    const nav = document.getElementById("site-nav");
    const toggle = document.getElementById("nav-menu-toggle");
    const panel = document.getElementById("nav-mobile-panel");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");
    if (!nav || !toggle || !panel || !iconOpen || !iconClose) return;

    const navRoot = nav;
    const menuToggle = toggle;
    const menuPanel = panel;
    const burgerOpen = iconOpen;
    const burgerClose = iconClose;

    mobileNavAbort?.abort();
    const ac = new AbortController();
    mobileNavAbort = ac;
    const sig = { signal: ac.signal };

    const mq = window.matchMedia("(min-width: 1024px)");

    function setOpen(open) {
      if (mq.matches) return;
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (open) {
        menuPanel.classList.remove("hidden");
        burgerOpen.classList.add("hidden");
        burgerClose.classList.remove("hidden");
      } else {
        menuPanel.classList.add("hidden");
        burgerOpen.classList.remove("hidden");
        burgerClose.classList.add("hidden");
      }
    }

    function closeIfMobile() {
      if (!mq.matches) setOpen(false);
    }

    menuToggle.addEventListener(
      "click",
      () => {
        const open = menuToggle.getAttribute("aria-expanded") === "true";
        setOpen(!open);
      },
      sig,
    );

    menuPanel.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", closeIfMobile, sig);
    });

    document.addEventListener(
      "click",
      (e) => {
        const t = e.target;
        if (!mq.matches && t instanceof Node && !navRoot.contains(t)) {
          closeIfMobile();
        }
      },
      sig,
    );

    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape") closeIfMobile();
      },
      sig,
    );

    mq.addEventListener(
      "change",
      () => {
        if (mq.matches) {
          menuPanel.classList.remove("hidden");
          burgerOpen.classList.remove("hidden");
          burgerClose.classList.add("hidden");
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Open menu");
        } else {
          setOpen(false);
        }
      },
      sig,
    );
  }

  initMobileNav();
  document.addEventListener("astro:page-load", initMobileNav);
</script>
