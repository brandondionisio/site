---
interface Props {
	clue: string;
	length: number;
	parDots: number;
	par: number;
	id: string;
	answer?: string;
	definition?: string;
	fodder?: string | string[];
	indicator?: string | string[];
	explanation?: string;
}

function toParts(v: string | readonly string[] | undefined): string[] {
	if (v == null) return [];
	const arr = Array.isArray(v) ? [...v] : [v];
	return arr.map((s) => String(s).trim()).filter((s) => s.length > 0);
}

const {
	clue,
	length,
	parDots: parDotCount,
	par,
	id,
	answer,
	definition,
	fodder,
	indicator,
	explanation,
} = Astro.props;
const safeId = id.replace(/[^a-zA-Z0-9_-]/g, "") || "cryptic";
const expectedAnswer = answer
	? answer.replace(/[^a-zA-Z]/g, "").toUpperCase()
	: "";
const hasAnswer = expectedAnswer.length > 0;
const fodderParts = toParts(fodder);
const indicatorParts = toParts(indicator);
const hasHints =
	Boolean(definition?.trim()) &&
	fodderParts.length > 0 &&
	indicatorParts.length > 0;
const slots = Array.from({ length }, (_, i) => i);
const dotCount = Math.max(0, Math.floor(parDotCount));
const dotIndices = Array.from({ length: dotCount }, (_, i) => i);
const parIndex0 =
	dotCount > 0 ? Math.min(Math.max(Math.floor(par) - 1, 0), dotCount - 1) : -1;
const explanationText = (explanation ?? "").trim();
---

<div
	id={safeId}
	class="cryptic-puzzle relative z-0 my-7 max-w-full overflow-visible rounded-lg border-2 border-zinc-900 bg-white p-4 text-zinc-800 shadow-[4px_4px_0_0_rgb(24,24,27)]"
	data-cryptic={safeId}
>
	<p
		class="cryptic-clue mb-4 rounded-md border-2 border-zinc-900 bg-white px-3 py-3 text-[0.95rem] leading-snug text-zinc-800 [&_mark]:rounded-sm [&_mark]:px-0.5"
		data-clue-output
	>
		{clue}<span class="whitespace-nowrap font-medium opacity-70"
			>&nbsp;({length})</span
		>
	</p>

	<div
		class="mb-4 flex max-w-full gap-1.5 overflow-x-auto pb-1"
		role="group"
		aria-label={`Answer, ${length} letters`}
	>
		{
			slots.map((i) => (
				<input
					type="text"
					name={`${safeId}-l${i}`}
					inputmode="text"
					autocapitalize="characters"
					autocomplete="off"
					spellcheck={false}
					maxlength={1}
					data-idx={i}
					aria-label={`Letter ${i + 1} of ${length}`}
					class="h-10 w-9 shrink-0 rounded-md border-2 border-zinc-900 bg-violet-50 text-center text-lg font-semibold uppercase tabular-nums tracking-wide text-zinc-800 shadow-[2px_2px_0_0_rgb(24,24,27)] outline-none transition-colors focus:bg-violet-100 focus:ring-2 focus:ring-fuchsia-500"
				/>
			))
		}
	</div>

	<div
		class="flex flex-col gap-3 border-t-2 border-dashed border-zinc-300 pt-3 sm:flex-row sm:items-center sm:justify-between"
	>
		<div class="flex items-center gap-2.5">
			<div
				class="flex gap-1.5"
				data-par-dots
				aria-label={`Hint track: ${dotCount} steps, par at ${parIndex0 + 1}`}
			>
				{
					dotIndices.map((i) => (
						<span
							class:list={[
								"par-dot shrink-0 rounded-full border-2 border-zinc-900 transition-colors",
								i === parIndex0
									? "h-3 w-3 bg-fuchsia-300/40 ring-2 ring-zinc-900 ring-offset-2 ring-offset-white"
									: "h-2.5 w-2.5 bg-zinc-200/80",
							]}
							data-par-dot={i}
							aria-hidden="true"
						/>
					))
				}
			</div>
			<span class="font-serif text-sm font-semibold italic text-zinc-900"
				>par</span
			>
		</div>

		<div class="flex flex-wrap items-center gap-2">
			<button
				type="button"
				class:list={[
					"rounded-full border-2 border-zinc-900 bg-amber-100 px-4 py-1.5 font-serif text-sm font-semibold italic text-zinc-900 shadow-[2px_2px_0_0_rgb(24,24,27)] transition-transform hover:translate-x-px hover:translate-y-px hover:shadow-[1px_1px_0_0_rgb(24,24,27)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none",
					!hasHints &&
						"cursor-not-allowed opacity-50 hover:translate-x-0 hover:translate-y-0 hover:shadow-[2px_2px_0_0_rgb(24,24,27)]",
				]}
				data-hints-btn
				aria-expanded="false"
				aria-controls={`${safeId}-hints-inline`}
				disabled={!hasHints}
				title={hasHints
					? "Show or hide hint options in the message area"
					: "Add definition, fodder, and indicator to enable hints"}
			>
				hints
			</button>
			<button
				type="button"
				class:list={[
					"rounded-full border-2 px-4 py-1.5 font-serif text-sm font-semibold italic shadow-[2px_2px_0_0_rgb(24,24,27)] transition-transform",
					hasAnswer
						? "border-zinc-900 bg-lime-50 text-zinc-900 hover:translate-x-px hover:translate-y-px hover:shadow-[1px_1px_0_0_rgb(24,24,27)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:translate-x-0 disabled:hover:translate-y-0 disabled:hover:shadow-[2px_2px_0_0_rgb(24,24,27)]"
						: "cursor-not-allowed border-zinc-300 bg-zinc-100 text-zinc-400 shadow-[2px_2px_0_0_rgb(212,212,216)]",
				]}
				data-check-btn
				disabled={!hasAnswer}
				title={hasAnswer ? "Check your answer" : "No answer configured"}
			>
				check
			</button>
			<button
				type="button"
				class="rounded-md border-2 border-zinc-900 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-zinc-800 shadow-[2px_2px_0_0_rgb(24,24,27)] transition-transform hover:translate-x-px hover:translate-y-px"
				data-clear-btn
				title="Clear entered letters (hints and par stay)"
			>
				clear
			</button>
			{
				hasAnswer && (
					<button
						type="button"
						class:list={[
							"rounded-md border-2 border-zinc-900 bg-violet-100 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-zinc-800 shadow-[2px_2px_0_0_rgb(24,24,27)] transition-transform hover:translate-x-px hover:translate-y-px",
						]}
						data-reveal-btn
						aria-expanded="false"
						aria-controls={`${safeId}-reveal-panel`}
						title="Show the solution and how it works"
					>
						reveal
					</button>
				)
			}
		</div>
	</div>

	<div class="mt-3 min-h-[1.35rem] space-y-2" data-feedback-area>
		<div
			id={`${safeId}-hints-inline`}
			class="rounded-md border-2 border-zinc-900 bg-gray-50/90 p-3"
			data-hints-inline
			hidden
			aria-hidden="true"
			role="region"
			aria-labelledby={`${safeId}-hints-title`}
		>
			<div class="flex items-start justify-between gap-2">
				<p
					id={`${safeId}-hints-title`}
					class="m-0 text-sm font-semibold text-zinc-800"
				>
					Select a hint
				</p>
				<button
					type="button"
					class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border-2 border-zinc-900 bg-white text-lg leading-none text-zinc-900 shadow-[2px_2px_0_0_rgb(24,24,27)] hover:bg-zinc-100"
					data-hints-close
					aria-label="Close hints"
				>
					×
				</button>
			</div>
			<ul class="m-0 list-none space-y-0 p-0">
				<li>
					<button
						type="button"
						class="cryptic-hint-opt w-full rounded-md border-0 bg-transparent px-2 py-2.5 text-left font-serif text-sm font-semibold italic text-zinc-900 hover:bg-fuchsia-100/90"
						data-hint-kind="indicator"
					>
						show indicators
					</button>
				</li>
				<li>
					<button
						type="button"
						class="cryptic-hint-opt w-full rounded-md border-0 bg-transparent px-2 py-2.5 text-left font-serif text-sm font-semibold italic text-zinc-900 hover:bg-amber-100/90"
						data-hint-kind="fodder"
					>
						show fodder
					</button>
				</li>
				<li>
					<button
						type="button"
						class="cryptic-hint-opt w-full rounded-md border-0 bg-transparent px-2 py-2.5 text-left font-serif text-sm font-semibold italic text-zinc-900 hover:bg-sky-100/90"
						data-hint-kind="definition"
					>
						show definition
					</button>
				</li>
			</ul>
		</div>
		<p
			class="text-sm font-semibold empty:hidden"
			data-check-msg
			hidden
			role="status"
			aria-live="polite"
		>
		</p>
		{
			hasAnswer && (
				<div
					id={`${safeId}-reveal-panel`}
					class="rounded-md border-2 border-violet-400/90 bg-violet-50/90 p-3"
					data-reveal-panel
					hidden
					aria-hidden="true"
				>
					<p
						class="m-0 font-mono text-base font-bold uppercase tracking-[0.2em] text-violet-950"
						data-reveal-answer
					/>
					<p
						class="mt-2 hidden whitespace-pre-wrap text-sm leading-relaxed text-zinc-800"
						data-reveal-explanation
					/>
				</div>
			)
		}
	</div>
</div>

<script
	define:vars={{
		safeId,
		expectedAnswer,
		hasAnswer,
		hasHints,
		length,
		clue,
		definition: definition ?? "",
		fodder: fodderParts,
		indicator: indicatorParts,
		dotCount,
		parIndex0,
		parTarget: Math.floor(Number(par)),
		explanationText,
	}}
>
	const root =
		document.getElementById(safeId) ??
		document.querySelector(`[data-cryptic="${safeId}"]`);
	if (!root) {
	} else {
		const clueOut = root.querySelector("[data-clue-output]");
		const inputs = Array.from(root.querySelectorAll("input[data-idx]")).sort(
			(a, b) =>
				Number(a.getAttribute("data-idx")) - Number(b.getAttribute("data-idx")),
		);
		const clearBtn = root.querySelector("[data-clear-btn]");
		const checkBtn = root.querySelector("[data-check-btn]");
		const checkMsg = root.querySelector("[data-check-msg]");
		const hintsBtn = root.querySelector("[data-hints-btn]");
		const hintsInline = root.querySelector("[data-hints-inline]");
		const hintsClose = root.querySelector("[data-hints-close]");
		const parDotsEl = root.querySelector("[data-par-dots]");
		const revealBtn = root.querySelector("[data-reveal-btn]");
		const revealPanel = root.querySelector("[data-reveal-panel]");
		const revealAnswerEl = root.querySelector("[data-reveal-answer]");
		const revealExplainEl = root.querySelector("[data-reveal-explanation]");

		let hintsUsed = 0;
		const usedKinds = new Set();
		let revealed = false;

		function hideRevealPanelFromDom() {
			if (!revealPanel) return;
			revealPanel.hidden = true;
			revealPanel.setAttribute("aria-hidden", "true");
			if (revealAnswerEl) revealAnswerEl.textContent = "";
			if (revealExplainEl) {
				revealExplainEl.textContent = "";
				revealExplainEl.classList.add("hidden");
			}
			revealed = false;
			if (revealBtn) {
				revealBtn.textContent = "reveal";
				revealBtn.setAttribute("aria-expanded", "false");
			}
		}

		function hideRevealAndClear() {
			hideRevealPanelFromDom();
			for (const el of inputs) {
				el.value = "";
			}
			resetCheckMessage();
			syncCheckButton();
		}

		function dismissRevealOnEdit() {
			if (!revealed) return;
			hideRevealPanelFromDom();
		}

		function parPhrase(used, target) {
			const diff = used - target;
			if (diff === 0) return "On par.";
			if (diff > 0) {
				if (diff === 1) return "One over par.";
				return `${diff} over par.`;
			}
			const below = -diff;
			if (below === 1) return "One below par.";
			return `${below} below par.`;
		}

		const markClass = {
			definition: "bg-sky-200/95 text-zinc-800",
			fodder: "bg-amber-200/95 text-zinc-800",
			indicator: "bg-fuchsia-200/95 text-zinc-800",
		};

		function findInsensitive(hay, needle) {
			const h = hay.toLowerCase();
			const n = needle.toLowerCase();
			const idx = h.indexOf(n);
			if (idx < 0) return null;
			return { start: idx, end: idx + needle.length };
		}

		function mergeRanges(ranges) {
			const valid = ranges.filter(Boolean);
			if (!valid.length) return [];
			valid.sort((a, b) => a.start - b.start);
			const out = [{ start: valid[0].start, end: valid[0].end }];
			for (let i = 1; i < valid.length; i++) {
				const cur = valid[i];
				const last = out[out.length - 1];
				if (cur.start <= last.end) {
					last.end = Math.max(last.end, cur.end);
				} else {
					out.push({ start: cur.start, end: cur.end });
				}
			}
			return out;
		}

		function rangesForParts(parts) {
			const ranges = [];
			for (const p of parts) {
				if (!p) continue;
				const r = findInsensitive(clue, p);
				if (r) ranges.push(r);
			}
			return mergeRanges(ranges);
		}

		function appendLengthSpan() {
			if (!clueOut) return;
			const wrap = document.createElement("span");
			wrap.innerHTML = `<span class="whitespace-nowrap font-medium opacity-70">&nbsp;(${length})</span>`;
			while (wrap.firstChild) clueOut.append(wrap.firstChild);
		}

		function collectUsedHighlightRanges() {
			const out = [];
			if (usedKinds.has("definition")) {
				const r = findInsensitive(clue, definition);
				if (r) out.push({ ...r, kind: "definition" });
			}
			if (usedKinds.has("fodder")) {
				for (const seg of rangesForParts(fodder)) {
					out.push({ start: seg.start, end: seg.end, kind: "fodder" });
				}
			}
			if (usedKinds.has("indicator")) {
				for (const seg of rangesForParts(indicator)) {
					out.push({ start: seg.start, end: seg.end, kind: "indicator" });
				}
			}
			return out;
		}

		const kindPriority = { definition: 3, fodder: 2, indicator: 1 };

		function fullyCovers(r, lo, hi) {
			return r.start <= lo && r.end >= hi;
		}

		function refreshClue() {
			if (!clueOut) return;
			clueOut.innerHTML = "";
			const hasTextHint =
				usedKinds.has("definition") ||
				usedKinds.has("fodder") ||
				usedKinds.has("indicator");
			if (!hasHints || !hasTextHint) {
				clueOut.append(document.createTextNode(clue));
				appendLengthSpan();
				return;
			}
			const ranges = collectUsedHighlightRanges();
			if (!ranges.length) {
				clueOut.append(document.createTextNode(clue));
				appendLengthSpan();
				return;
			}
			const bps = new Set([0, clue.length]);
			for (const r of ranges) {
				bps.add(r.start);
				bps.add(r.end);
			}
			const sorted = [...bps].sort((a, b) => a - b);
			for (let i = 0; i < sorted.length - 1; i++) {
				const lo = sorted[i];
				const hi = sorted[i + 1];
				if (lo >= hi) continue;
				const text = clue.slice(lo, hi);
				const cov = ranges.filter((r) => fullyCovers(r, lo, hi));
				if (!cov.length) {
					clueOut.append(document.createTextNode(text));
					continue;
				}
				cov.sort((a, b) => kindPriority[b.kind] - kindPriority[a.kind]);
				const win = cov[0].kind;
				const mark = document.createElement("mark");
				mark.className = markClass[win] ?? markClass.definition;
				mark.append(document.createTextNode(text));
				clueOut.append(mark);
			}
			appendLengthSpan();
		}

		function syncHintMenuButtons() {
			root.querySelectorAll("[data-hint-kind]").forEach((btn) => {
				const k = btn.getAttribute("data-hint-kind");
				if (!k) return;
				const used = usedKinds.has(k);
				btn.disabled = used;
				btn.classList.toggle("line-through", used);
				btn.classList.toggle("opacity-40", used);
				btn.classList.toggle("cursor-not-allowed", used);
			});
		}

		function syncParDots() {
			if (!parDotsEl) return;
			const dots = parDotsEl.querySelectorAll("[data-par-dot]");
			dots.forEach((dot, i) => {
				const el = dot;
				const isPar = i === parIndex0;
				const used = i < hintsUsed;
				el.className = [
					"par-dot shrink-0 rounded-full border-2 border-zinc-900 transition-colors",
					isPar
						? "h-3 w-3 ring-2 ring-zinc-900 ring-offset-2 ring-offset-white"
						: "h-2.5 w-2.5",
					used ? "bg-pink-300" : isPar ? "bg-fuchsia-300/40" : "bg-zinc-200/80",
				].join(" ");
			});
		}

		function openHints() {
			if (!hasHints || !hintsInline) return;
			resetCheckMessage();
			hintsInline.hidden = false;
			hintsInline.setAttribute("aria-hidden", "false");
			hintsBtn?.setAttribute("aria-expanded", "true");
			syncHintMenuButtons();
			hintsClose?.focus();
		}

		function closeHints(opts) {
			if (!hintsInline) return;
			hintsInline.hidden = true;
			hintsInline.setAttribute("aria-hidden", "true");
			hintsBtn?.setAttribute("aria-expanded", "false");
			if (opts?.focusHintsButton) hintsBtn?.focus({ preventScroll: true });
		}

		function bumpParIfNew(kind) {
			if (usedKinds.has(kind)) return;
			usedKinds.add(kind);
			if (hintsUsed < dotCount) hintsUsed += 1;
			refreshClue();
			syncParDots();
			syncHintMenuButtons();
		}

		function allFilled() {
			return inputs.every((el) => el.value.length === 1);
		}

		function resetCheckMessage() {
			if (!checkMsg) return;
			checkMsg.textContent = "";
			checkMsg.hidden = true;
			checkMsg.className = "text-sm font-semibold empty:hidden";
		}

		function syncCheckButton() {
			if (!checkBtn || !hasAnswer) return;
			checkBtn.disabled = !allFilled();
		}

		refreshClue();
		syncParDots();
		syncHintMenuButtons();

		clearBtn?.addEventListener("click", () => {
			closeHints();
			hideRevealPanelFromDom();
			for (const el of inputs) {
				el.value = "";
			}
			resetCheckMessage();
			syncCheckButton();
			inputs[0]?.focus();
		});

		for (let i = 0; i < inputs.length; i++) {
			const input = inputs[i];
			input.addEventListener("input", () => {
				const v = input.value
					.replace(/[^a-zA-Z]/g, "")
					.slice(-1)
					.toUpperCase();
				input.value = v;
				if (v && i < inputs.length - 1) {
					inputs[i + 1].focus();
				}
				dismissRevealOnEdit();
				closeHints();
				resetCheckMessage();
				syncCheckButton();
			});
			input.addEventListener("keydown", (e) => {
				if (e.key === "Backspace" && !input.value && i > 0) {
					e.preventDefault();
					inputs[i - 1].focus();
					inputs[i - 1].value = "";
					dismissRevealOnEdit();
					closeHints();
					resetCheckMessage();
					syncCheckButton();
				}
			});
		}

		hintsBtn?.addEventListener("click", () => {
			if (!hasHints || !hintsInline) return;
			if (!hintsInline.hidden) {
				closeHints();
				return;
			}
			openHints();
		});
		hintsClose?.addEventListener("click", () =>
			closeHints({ focusHintsButton: true }),
		);

		root.querySelectorAll("[data-hint-kind]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const kind = btn.getAttribute("data-hint-kind");
				if (!kind) return;
				if (usedKinds.has(kind)) return;
				bumpParIfNew(kind);
				closeHints();
			});
		});

		document.addEventListener("keydown", (e) => {
			if (e.key !== "Escape") return;
			if (hintsInline && !hintsInline.hidden && root.contains(hintsInline)) {
				closeHints({ focusHintsButton: true });
				e.preventDefault();
				return;
			}
			if (
				revealed &&
				revealPanel &&
				!revealPanel.hidden &&
				root.contains(revealPanel)
			) {
				hideRevealAndClear();
				e.preventDefault();
			}
		});

		revealBtn?.addEventListener("click", () => {
			if (!revealPanel || !hasAnswer) return;
			if (revealed) {
				hideRevealAndClear();
				return;
			}
			closeHints();
			resetCheckMessage();
			const letters = expectedAnswer.split("");
			for (let i = 0; i < inputs.length && i < letters.length; i++) {
				inputs[i].value = letters[i] ?? "";
			}
			if (revealAnswerEl) revealAnswerEl.textContent = expectedAnswer;
			if (revealExplainEl) {
				revealExplainEl.textContent = explanationText;
				revealExplainEl.classList.toggle("hidden", !explanationText);
			}
			revealPanel.hidden = false;
			revealPanel.setAttribute("aria-hidden", "false");
			revealed = true;
			revealBtn.textContent = "hide";
			revealBtn.setAttribute("aria-expanded", "true");
			syncCheckButton();
		});

		checkBtn?.addEventListener("click", () => {
			if (!hasAnswer || !checkMsg) return;
			closeHints();
			if (!allFilled()) {
				checkMsg.textContent = "Fill every square first.";
				checkMsg.hidden = false;
				checkMsg.className = "text-sm font-semibold text-amber-800";
				return;
			}
			const got = inputs
				.map((el) => el.value)
				.join("")
				.toUpperCase();
			if (got === expectedAnswer) {
				checkMsg.textContent =
					dotCount > 0
						? `Correct! ${parPhrase(hintsUsed, parTarget)}`
						: "Correct!";
				checkMsg.hidden = false;
				checkMsg.className = "text-sm font-semibold text-emerald-700";
			} else {
				checkMsg.textContent = "Not quite — keep trying.";
				checkMsg.hidden = false;
				checkMsg.className = "text-sm font-semibold text-rose-700";
			}
		});

		syncCheckButton();
	}
</script>
