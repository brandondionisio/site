---
interface Props {
	label?: string;
}

const { label = "Continue" } = Astro.props;
---

<details
	class="spoiler-continue group my-8 w-full [&_summary::-webkit-details-marker]:hidden"
>
	<summary
		class="group/summary mx-auto flex w-fit cursor-pointer list-none flex-col items-center rounded-md select-none outline-none dark:focus-visible:ring-offset-zinc-900"
	>
		<span
			class="inline-flex items-center justify-center rounded-md text-[var(--accent)] text-sm font-semibold"
		>
			{label}
		</span>
		<span
			class="inline-flex h-8 w-8 shrink-0 items-center justify-center text-[var(--accent)] transition-transform duration-200 ease-out motion-reduce:transition-none group-hover/summary:translate-y-0.5 group-open:group-hover/summary:-translate-y-0.5"
			aria-hidden="true"
		>
			<svg
				class="block h-full w-full max-h-full max-w-full origin-center transition-transform duration-200 ease-out motion-reduce:transition-none group-open:scale-y-[-1]"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 20 20"
				width="12"
				height="12"
				fill="currentColor"
				focusable="false"
				aria-hidden="true"
			>
				<path
					fill-rule="evenodd"
					d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
					clip-rule="evenodd"></path>
			</svg>
		</span>
	</summary>
	<div class="mt-6 w-full self-stretch">
		<slot />
	</div>
</details>
