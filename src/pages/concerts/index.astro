---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Nav from "../../components/Nav.astro";
import { CONCERTS_TITLE, SITE_TITLE } from "../../consts";
import { formatConcertDate, getConcertsByYear } from "../../data/concerts";

const byYear = getConcertsByYear();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${CONCERTS_TITLE} | ${SITE_TITLE}`}
      description="Every concert I've been to"
    />
  </head>
  <body>
    <Nav currentPath={Astro.url.pathname} />
    <main
      class="w-full max-w-[760px] mx-auto px-6 py-32 lg:py-20 flex flex-col"
    >
      <header class="mb-10 flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h1 class="text-4xl font-bold text-primary m-0 mb-2 tracking-tight">
            Concerts
          </h1>
          <p class="text-secondary m-0 mb-3 text-base">
            Every concert I've been to.
          </p>
        </div>
        <a
          href="https://open.spotify.com/user/qzkliw9p48sr5ct0lpowweq5c?si=f590e591b4014d37"
          title="Spotify"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-[35px] w-[35px] shrink-0 items-center justify-center rounded-full hover:scale-110 transition-transform duration-300 no-underline"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="45"
            height="45"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="12" fill="#1DB954"></circle>
            <path
              fill="none"
              stroke="black"
              stroke-width="1.6"
              stroke-linecap="round"
              d="M6.6 15.4c3.4-.95 7.3-.75 10.3.85"></path>
            <path
              fill="none"
              stroke="black"
              stroke-width="1.6"
              stroke-linecap="round"
              d="M5.7 12.05c3.9-1.15 8.3-.95 11.7.95"></path>
            <path
              fill="none"
              stroke="black"
              stroke-width="1.6"
              stroke-linecap="round"
              d="M4.9 8.65c4.4-1.3 9.4-1.1 13.4 1.15"></path>
          </svg>
          <span class="sr-only">Spotify</span>
        </a>
      </header>

      <div class="flex flex-col gap-10">
        {
          byYear.map(({ year, concerts: yearConcerts }) => (
            <section>
              <h2 class="text-sm font-medium text-secondary/70 m-0 mb-3">
                {year}
              </h2>
              <ul class="list-none m-0 p-0 flex flex-col gap-4">
                {yearConcerts.map((concert) => {
                  const { month, day } = formatConcertDate(concert.date);
                  const hasImage = Boolean(concert.image);
                  const lightText = concert.textColor === "white";
                  return (
                    <li class="concert-ticket-wrap" data-concert-tilt>
                      <article class="concert-ticket flex items-stretch min-h-[7.5rem] sm:min-h-[8.5rem] bg-[var(--page-bg-secondary)]">
                        <div class="flex flex-col items-center justify-center shrink-0 w-[5.25rem] sm:w-24 px-2 py-5 bg-[var(--page-bg-secondary)]">
                          <span class="text-[11px] font-medium tracking-wider text-secondary uppercase leading-none">
                            {month}
                          </span>
                          <span class="mt-1.5 text-2xl sm:text-3xl font-bold text-primary leading-none tabular-nums">
                            {day}
                          </span>
                        </div>
                        <div
                          class="w-0 shrink-0 self-stretch my-3 border-l border-dashed border-[var(--border-subtle)]"
                          aria-hidden="true"
                        />
                        <div
                          class:list={[
                            "relative flex items-center flex-1 min-w-0 overflow-hidden",
                            hasImage &&
                              "after:content-[''] after:absolute after:inset-0 after:pointer-events-none",
                            hasImage &&
                              lightText &&
                              "after:bg-gradient-to-r after:from-black/40 after:via-black/15 after:to-transparent",
                            hasImage &&
                              !lightText &&
                              "after:bg-gradient-to-r after:from-white/45 after:via-white/15 after:to-transparent",
                          ]}
                        >
                          {concert.image && (
                            <Image
                              src={concert.image}
                              alt=""
                              width={720}
                              height={280}
                              class="absolute inset-0 w-full h-full object-cover object-center"
                              loading="lazy"
                            />
                          )}
                          <div class="relative z-[1] flex flex-col justify-center min-w-0 w-full px-5 py-5">
                            <span
                              class:list={[
                                "font-semibold leading-snug",
                                lightText
                                  ? "text-white [text-shadow:0_1px_3px_rgb(0_0_0_/_0.55)]"
                                  : "text-primary",
                              ]}
                            >
                              {concert.artist}
                            </span>
                            {concert.openers && concert.openers.length > 0 && (
                              <span
                                class:list={[
                                  "mt-0.5 text-sm leading-snug",
                                  lightText
                                    ? "text-white/85 [text-shadow:0_1px_2px_rgb(0_0_0_/_0.45)]"
                                    : "text-secondary",
                                ]}
                              >
                                with {concert.openers.join(", ")}
                              </span>
                            )}
                            <span
                              class:list={[
                                "mt-0.5 text-sm leading-snug",
                                lightText
                                  ? "text-white/85 [text-shadow:0_1px_2px_rgb(0_0_0_/_0.45)]"
                                  : "text-secondary",
                              ]}
                            >
                              {concert.venue} — {concert.city}
                            </span>
                          </div>
                        </div>
                      </article>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
    </main>
  </body>
</html>

<style>
  .concert-ticket-wrap {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --tilt-scale: 1;
    transform: perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y))
      scale(var(--tilt-scale));
    transform-style: preserve-3d;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.35s ease;
    filter: drop-shadow(
        0 0 0.8px color-mix(in srgb, var(--text-primary) 28%, transparent)
      )
      drop-shadow(
        0 0 1.5px color-mix(in srgb, var(--text-primary) 18%, transparent)
      )
      drop-shadow(0 2px 4px rgb(0 0 0 / 0.06));
    will-change: transform;
  }

  .concert-ticket-wrap.is-tilting {
    transition: filter 0.35s ease;
    filter: drop-shadow(
        0 0 0.8px color-mix(in srgb, var(--text-primary) 32%, transparent)
      )
      drop-shadow(
        0 0 1.5px color-mix(in srgb, var(--text-primary) 20%, transparent)
      )
      drop-shadow(0 10px 18px rgb(0 0 0 / 0.12));
  }

  .concert-ticket {
    --notch: 0.75rem;
    -webkit-mask:
      radial-gradient(circle var(--notch) at 0% 50%, #0000 98%, #000) left / 51%
        100% no-repeat,
      radial-gradient(circle var(--notch) at 100% 50%, #0000 98%, #000) right /
        51% 100% no-repeat;
    mask:
      radial-gradient(circle var(--notch) at 0% 50%, #0000 98%, #000) left / 51%
        100% no-repeat,
      radial-gradient(circle var(--notch) at 100% 50%, #0000 98%, #000) right /
        51% 100% no-repeat;
  }

  @media (prefers-reduced-motion: reduce) {
    .concert-ticket-wrap {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // @ts-nocheck
  let tiltAbort = null;

  function initConcertTilt() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    tiltAbort?.abort();
    const ac = new AbortController();
    tiltAbort = ac;
    const sig = { signal: ac.signal };

    const maxTilt = 7;

    document.querySelectorAll("[data-concert-tilt]").forEach((card) => {
      card.addEventListener(
        "pointermove",
        (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          const tiltY = (x - 0.5) * maxTilt * 2;
          const tiltX = (0.5 - y) * maxTilt * 2;
          card.classList.add("is-tilting");
          card.style.setProperty("--tilt-x", `${tiltX.toFixed(2)}deg`);
          card.style.setProperty("--tilt-y", `${tiltY.toFixed(2)}deg`);
          card.style.setProperty("--tilt-scale", "1.02");
        },
        sig,
      );

      card.addEventListener(
        "pointerleave",
        () => {
          card.classList.remove("is-tilting");
          card.style.setProperty("--tilt-x", "0deg");
          card.style.setProperty("--tilt-y", "0deg");
          card.style.setProperty("--tilt-scale", "1");
        },
        sig,
      );
    });
  }

  initConcertTilt();
  document.addEventListener("astro:page-load", initConcertTilt);
</script>
